[Unit]
Description=AI-NIDS Next.js Dashboard
After=network.target ai-nids-api.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_ROOT}}/frontend

# Run Next.js production server on port 3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

Environment="NODE_ENV=production"
Environment="PORT=3000"

[Install]
WantedBy=multi-user.target
