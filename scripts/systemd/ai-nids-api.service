# ==============================================================================
# AI-NIDS FastAPI Backend Service
# ==============================================================================
# REST API for the frontend dashboard. Serves Next.js static export at /.
# Depends on the monitor service being started first.
#
# Template variables (replaced by scripts/deploy.sh):
#   {{PROJECT_ROOT}}  — absolute path to project root
#   {{USER}}          — current user (does NOT run as root)
# ==============================================================================

[Unit]
Description=AI-NIDS FastAPI Backend
After=network.target ai-nids-monitor.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_ROOT}}
Environment="PATH={{PROJECT_ROOT}}/ai-venv/bin"

# Run FastAPI server on port 8000
ExecStart={{PROJECT_ROOT}}/ai-venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
